# Firebase Cloud Functions Environment Variables
# Copy this file to functions/.env and fill in your details:

# Recipient email address
TO_EMAIL=mohaneswar3@gmail.com, ram.annadanam@gmail.com

# Sender email display (e.g. AJHA Website <your-email@gmail.com>)
FROM_EMAIL="AJHA Consultancy Website" <your-email@gmail.com>

# SMTP Configuration:
# Option A: Gmail with App Password (Recommended for simple setup)
# 1. Go to your Google Account -> Security -> 2-Step Verification -> App Passwords
# 2. Generate an App Password for 'Mail' / 'AJHA Website'
# 3. Enter your Gmail and 16-character app password below:
SMTP_SERVICE=gmail
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Option B: Custom SMTP Server (SendGrid, Mailgun, Brevo, AWS SES, etc.)
# If using custom SMTP, uncomment and configure below:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-api-key
